# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
DB_PASSWORD=CAMBIAR_Postgres_2026*
JWT_SECRET=CAMBIAR_por_una_clave_aleatoria_de_al_menos_32_caracteres
# Clave para llamadas internas entre microservicios. Si se omite, se usa JWT_SECRET.
INTERNAL_API_KEY=CAMBIAR_otra_clave_aleatoria_de_al_menos_32_caracteres
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://sistemadistribuido2026.com,http://www.sistemadistribuido2026.com
# Puerto público del frontend (nginx).
FRONTEND_PORT=80

BOOTSTRAP_ADMIN_USERNAME=director
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_Director_2026*
BOOTSTRAP_ADMIN_EMAIL=director@institucion.edu.pe
BOOTSTRAP_SYSTEM_ADMIN_USERNAME=admin
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=CAMBIAR_Admin_2026*
BOOTSTRAP_SYSTEM_ADMIN_EMAIL=admin@institucion.edu.pe
SEED_DEMO_DATA=false
DEMO_STUDENTS_PER_SECTION=20
DEMO_LOAD_SCHEDULES=true
DEMO_RESET_SCHEDULES=false
DATA_CONSENT_POLICY_VERSION=2026-01
BACKUP_ENCRYPTION_KEY=CAMBIAR_frase_larga_para_cifrar_respaldos
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

RABBITMQ_USER=pad
RABBITMQ_PASSWORD=CAMBIAR_Rabbit_2026*
NOTIFICATIONS_MODE=SIMULATED
# Para entregas reales usa WEBHOOK y configura HTTPS para todos los canales requeridos.
NOTIFICATIONS_EMAIL_WEBHOOK_URL=
NOTIFICATIONS_SMS_WEBHOOK_URL=
NOTIFICATIONS_WHATSAPP_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_TOKEN=
NOTIFICATIONS_REQUIRED_CHANNELS=EMAIL,SMS,WHATSAPP

PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=CAMBIAR_PgAdmin_2026*

# Perfil "observability" (Grafana).
GRAFANA_USER=admin
GRAFANA_PASSWORD=CAMBIAR_Grafana_2026*

# Ingreso al colegio con DNI: hora límite por turno y a quién avisar (TODOS, TARDANZAS o NINGUNO).
INGRESO_LIMITE_MANANA=07:45
INGRESO_LIMITE_TARDE=13:45
INGRESO_CAMBIO_TURNO=12:30
INGRESO_NOTIFICAR=TARDANZAS
